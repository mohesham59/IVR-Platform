# ============================================================
# NexusIVR AI Engine — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit a .env file with real secrets to source control.
# ============================================================

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://<host>/<db>?sslmode=require&channelBinding=require
DB_USER=<your_neon_user>
DB_PASSWORD=<your_neon_password>

DATABASE_URL=jdbc:postgresql://<host>/<db>?sslmode=require&channelBinding=require
DATABASE_USER=<your_neon_user>
DATABASE_PASSWORD=<your_neon_password>

# AI Provider Credentials
AI_PROVIDER=groq
GEMINI_API_KEY=<your_gemini_api_key>
GROQ_API_KEY=<your_groq_api_key>
OPENROUTER_API_KEY=<your_openrouter_key>
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-oss-20b
OLLAMA_BASE_URL=http://localhost:11434

# --------------------------------------------------
# IVR Engine Directory & Script Overrides (Optional)
# --------------------------------------------------
# By default, paths are resolved dynamically relative to the project root:
#   Project Root: <auto-detected>
#   add_extension.sh: <project_root>/IVR-engine/add_extension.sh
#   Scenarios Dir:    <project_root>/IVR-engine/scenarios
#   Drafts Dir:       <project_root>/IVR-engine/drafts
# Only set these variables if IVR-engine is located outside the repository root.
# IVR_ENGINE_ROOT=/path/to/project/root
# IVR_ENGINE_SCENARIOS_DIR=/path/to/IVR-engine/scenarios
# IVR_ENGINE_DRAFTS_DIR=/path/to/IVR-engine/drafts
# IVR_ENGINE_ADD_EXTENSION_SCRIPT=/path/to/IVR-engine/add_extension.sh

