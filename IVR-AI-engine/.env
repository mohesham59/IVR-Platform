# ============================================================
# NexusIVR AI Backend — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# Do NOT commit a .env file containing real secrets to source control.
# ============================================================

# --------------------------------------------------
# AI Provider Selection
# --------------------------------------------------
# Options: gemini | groq | ollama | openai | claude | mock
AI_PROVIDER=groq

# --------------------------------------------------
# Google Gemini API
# --------------------------------------------------
GEMINI_API_KEY=AQ.Ab8RN6KzIHvO5SnCb5V9Mr23nFGp7gQqmtVbPQ5SDGdpBTlkiQ
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT=30

# --------------------------------------------------
# Groq Cloud API  (secondary / 429-fallback provider — keep intact)
# --------------------------------------------------
GROQ_API_KEY=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
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT=30

# --------------------------------------------------
# Ollama Local LLM (local provider)
# --------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=granite3.2:2b
OLLAMA_TIMEOUT=60

# --------------------------------------------------
# OpenAI — disabled, kept for future use
# --------------------------------------------------
OPENAI_ENABLED=false

# --------------------------------------------------
# PostgreSQL Database
# --------------------------------------------------
DATABASE_URL=jdbc:postgresql://localhost:5432/nexusivr
DATABASE_USER=nexusivr
DATABASE_PASSWORD=nexusivr

# --------------------------------------------------
# Logging
# --------------------------------------------------
LOG_LEVEL=INFO

# --------------------------------------------------
# IVR Engine Integration
# --------------------------------------------------
IVR_ENGINE_SCENARIOS_DIR=/home/mohamed/IdeaProjects/IVR_project/IVR_platform/IVR-engine/scenarios
IVR_ADD_EXTENSION_SCRIPT=/home/mohamed/IdeaProjects/IVR_project/IVR_platform/IVR-engine/add_extension.sh
