; =====================================================================
; Asterisk Dialplan for VXML IVR Testing
; =====================================================================
; 
; This dialplan demonstrates how to call different VXML scenarios
; using the Java-based IVR platform with FastAGI.
;
; Usage: Call any extension from your SIP client (Zoiper)
; Example: Dial 500 from extension 1001
;

[default]

; =====================================================================
; Direct calls between extensions (PJSIP)
; =====================================================================
exten => 1001,1,Dial(PJSIP/1001,20)
same  => n,Hangup()

exten => 1002,1,Dial(PJSIP/1002,20)
same  => n,Hangup()


; =====================================================================
; Echo test (audio test)
; =====================================================================
exten => 9999,1,Answer()
same  => n,Echo()
same  => n,Hangup()


; =====================================================================
; Simple IVR (built-in Asterisk, for reference)
; =====================================================================
exten => 7777,1,Answer()
same  => n,Read(DIGIT,beep,1)
same  => n,Goto(menu,${DIGIT},1)


; =====================================================================
; **MAIN VXML SCENARIOS** (Java IVR Platform via FastAGI)
; =====================================================================

; =====================================================================
; Extension 500: Hello World VXML (Simple greeting)
; =====================================================================
; Usage: Dial 500 from your SIP phone
; VXML: hello.vxml
; Expected: "Hello. Welcome to the IVR system."
; =====================================================================
exten => 500,1,NoOp(=== VXML IVR: Hello World ===)
same  => n,Answer()
same  => n,NoOp(Calling Java IVR via FastAGI for: hello.vxml)
same  => n,AGI(agi://127.0.0.1:4573/hello)
same  => n,NoOp(VXML Session ID: ${VXML_SESSION_ID}, State: ${VXML_STATE})
same  => n,GotoIf($["${VXML_STATE}" = "COMPLETED"]?success:error)
same  => n(success),NoOp(VXML executed successfully)
same  => n,Hangup()
same  => n(error),NoOp(VXML execution failed: ${VXML_ERROR})
same  => n,Hangup()


; =====================================================================
; Extension 501: Menu Example VXML (Interactive menu)
; =====================================================================
; Usage: Dial 501 from your SIP phone
; VXML: menu-example.vxml
; Expected: Menu prompt, responds to DTMF input (1, 2, 0)
; DTMF 1: "You selected reservations"
; DTMF 2: "You selected information"
; DTMF 0: Transfer to operator
; =====================================================================
exten => 501,1,NoOp(=== VXML IVR: Menu Example ===)
same  => n,Answer()
same  => n,Set(VXML_FILE=menu-example)
same  => n,AGI(agi://127.0.0.1:4573/menu)
same  => n,NoOp(Menu result - Session: ${VXML_SESSION_ID})
same  => n,NoOp(User selected: ${VXML_RESULT_user_choice})
same  => n,Hangup()


; =====================================================================
; Extension 502: Transfer Example VXML (Chain VXML files)
; =====================================================================
; Usage: Dial 502 from your SIP phone
; VXML: transfer-example.vxml
; Expected: "Transferring you to the next menu" then chains to menu-example.vxml
; =====================================================================
exten => 502,1,NoOp(=== VXML IVR: Transfer Example ===)
same  => n,Answer()
same  => n,Set(VXML_FILE=transfer-example)
same  => n,AGI(agi://127.0.0.1:4573/transfer)
same  => n,Hangup()


; =====================================================================
; Extension 503: Restaurant Booking VXML (Legacy converted)
; =====================================================================
; Usage: Dial 503 from your SIP phone
; VXML: restaurant-booking-001.xml
; Expected: Multi-step form for restaurant booking
; =====================================================================
exten => 503,1,NoOp(=== VXML IVR: Restaurant Booking ===)
same  => n,Answer()
same  => n,Set(VXML_FILE=restaurant-booking-001)
same  => n,AGI(agi://127.0.0.1:4573/restaurant)
same  => n,NoOp(Booking info - Date: ${VXML_RESULT_res_date}, Time: ${VXML_RESULT_res_time})
same  => n,Hangup()


; =====================================================================
; Extension 504: Dynamic VXML Selector
; =====================================================================
; Usage: Dial 504, then enter VXML name code (see menu below)
; Advanced: Allows selecting any VXML by code
; =====================================================================
exten => 504,1,NoOp(=== VXML IVR: Dynamic Selector ===)
same  => n,Answer()
same  => n,Playback(vm-welcome)
same  => n,Playback(silence/1)
same  => n,Read(VXML_CODE,beep,1)
same  => n,GotoIf($["${VXML_CODE}" = "1"]?hello)
same  => n,GotoIf($["${VXML_CODE}" = "2"]?menu)
same  => n,GotoIf($["${VXML_CODE}" = "3"]?transfer)
same  => n,GotoIf($["${VXML_CODE}" = "4"]?restaurant)
same  => n,Playback(vm-invalid)
same  => n,Hangup()
same  => n(hello),Set(VXML_FILE=hello)
same  => n,AGI(agi://127.0.0.1:4573/hello)
same  => n,Hangup()
same  => n(menu),Set(VXML_FILE=menu-example)
same  => n,AGI(agi://127.0.0.1:4573/menu)
same  => n,Hangup()
same  => n(transfer),Set(VXML_FILE=transfer-example)
same  => n,AGI(agi://127.0.0.1:4573/transfer)
same  => n,Hangup()
same  => n(restaurant),Set(VXML_FILE=restaurant-booking-001)
same  => n,AGI(agi://127.0.0.1:4573/restaurant)
same  => n,Hangup()


; =====================================================================
; Extension 8000: Testing Lab (legacy, for reference)
; =====================================================================
exten => 8000,1,NoOp(Starting Java IVR - Testing Lab)
same  => n,Answer()
same  => n,AGI(agi://127.0.0.1:4573/myivr)
same  => n,Hangup()


; =====================================================================
; Extension 8080: Query User Balance (legacy, for reference)
; =====================================================================
exten => 8080,1,NoOp(Starting Java IVR - Query Balance)
same  => n,Answer()
same  => n,AGI(agi://127.0.0.1:4573/balance)
same  => n,Hangup()


; =====================================================================
; Menu for Extension Selection
; =====================================================================
[menu]

exten => 1,1,Playback(hello-world)
same  => n,Hangup()

exten => 2,1,Playback(demo-thanks)
same  => n,Hangup()

exten => 0,1,Playback(vm-goodbye)
same  => n,Hangup()
