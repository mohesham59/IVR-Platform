# ============================================================
# NexusIVR Payment Service — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit a .env file with real secrets to source control.
# ============================================================

# Paymob API Credentials & Configuration (Region: Egypt, Currency: EGP)
PAYMOB_API_KEY=your_api_key_here
PAYMOB_SECRET_KEY=your_secret_key_here
PAYMOB_PUBLIC_KEY=your_public_key_here
PAYMOB_HMAC_SECRET=your_hmac_secret_here

# Paymob Integration & Frame IDs
PAYMOB_INTEGRATION_ID_CARD=your_card_integration_id
PAYMOB_INTEGRATION_ID_WALLET=your_wallet_integration_id
PAYMOB_MOTO_INTEGRATION_ID=your_moto_integration_id
PAYMOB_IFRAME_ID=your_iframe_id

# Service Configuration
PAYMENT_SERVICE_PORT=8082

# Shared Platform Database Configuration (PostgreSQL 15+)
DATABASE_URL=jdbc:postgresql://localhost:5432/nexusivr
DATABASE_USER=nexusivr
DATABASE_PASSWORD=
