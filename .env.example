# ============================================================
# NexusIVR Platform — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit a .env file with real secrets to source control.
# ============================================================

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://<host>/<db>?sslmode=require&channelBinding=require
DB_USER=<your_neon_user>
DB_PASSWORD=<your_neon_password>

DATABASE_URL=jdbc:postgresql://<host>/<db>?sslmode=require&channelBinding=require
DATABASE_USER=<your_neon_user>
DATABASE_PASSWORD=<your_neon_password>

# AI Provider Credentials
AI_PROVIDER=groq
GEMINI_API_KEY=<your_gemini_api_key>
GROQ_API_KEY=<your_groq_api_key>
OPENROUTER_API_KEY=<your_openrouter_key>
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-oss-20b
OLLAMA_BASE_URL=http://localhost:11434

# Payment Service Configuration (Paymob Egypt - EGP)
PAYMENT_SERVICE_PORT=8082
PAYMOB_API_KEY=<your_paymob_api_key>
PAYMOB_SECRET_KEY=<your_paymob_secret_key>
PAYMOB_PUBLIC_KEY=<your_paymob_public_key>
PAYMOB_HMAC_SECRET=<your_paymob_hmac_secret>
PAYMOB_INTEGRATION_ID_CARD=5834828
PAYMOB_INTEGRATION_ID_WALLET=5834829
PAYMOB_MOTO_INTEGRATION_ID=5834830
PAYMOB_IFRAME_ID=1067447
