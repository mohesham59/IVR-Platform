<?xml version="1.0" encoding="UTF-8"?>
<vxml version="2.1" xmlns="http://www.w3.org/2001/vxml">
  <!-- Start (n1) -->
  <form id="n1">
      <prompt>Welcome to Restaurant Services. Press 1 for Takeout Orders. Press 2 for Reservations. Press 3 for Hostess. Press 0 to speak to an agent.</prompt>
      <goto next="#n2"/>
  </form>
  <!-- Menu (n2) -->
  <form id="n2">
    <menu>
      <prompt>Please select an option.</prompt>
      <choice dtmf="1" next="#n3">Key 1</choice>
      <choice dtmf="2" next="#n3">Key 2</choice>
      <choice dtmf="3" next="#n3">Key 3</choice>
      <choice dtmf="0" next="#n3">Key 0</choice>
    </menu>
  </form>
  <!-- Takeout orders (n3) -->
  <form id="n3">
      <prompt>Please hold while we connect you to Takeout Orders.</prompt>
      <goto next="#n7"/>
  </form>
  <!-- Reservations (n4) -->
  <form id="n4">
      <prompt>Please hold while we connect you to Reservations.</prompt>
      <goto next="#n7"/>
  </form>
  <!-- Hostess (n5) -->
  <form id="n5">
      <prompt>Please hold while we connect you to Hostess.</prompt>
      <goto next="#n7"/>
  </form>
  <!-- Agent (n6) -->
  <form id="n6">
      <prompt>Please hold while we connect you to a representative.</prompt>
      <goto next="#n7"/>
  </form>
  <!-- End Call (n7) -->
  <form id="n7">
    <block>
      <prompt>Hang up</prompt>
      <disconnect/>
    </block>
  </form>
</vxml>