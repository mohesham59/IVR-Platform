<?xml version="1.0" encoding="UTF-8"?>
<vxml version="2.1" xmlns="http://www.w3.org/2001/vxml">
  <!-- Flow Name: Frontend Flow -->
  <!-- Start (n1) -->
  <form id="n1" type="start" title="Start" subtitle="Entry Point">
    <!-- Edge: id="e_edge_13", port="out", target="n2", targetPort="in", label="" -->
      <prompt>Entry Point</prompt>
      <goto next="#n2"/>
  </form>
  <!-- Welcome Greeting (n2) -->
  <form id="n2" type="prompt" title="Welcome Greeting" subtitle="Welcome to [Hotel Name], your home away from home. For as...">
    <!-- Edge: id="e_edge_1", port="out", target="n3", targetPort="in", label="" -->
      <prompt>Welcome to [Hotel Name], your home away from home. For as...</prompt>
      <goto next="#n3"/>
  </form>
  <!-- Hotel Main Menu (n3) -->
  <form id="n3" type="menu" title="Hotel Main Menu" subtitle="Press 1 for Reservations, Press 2 for Front Desk, Press 3...">
    <!-- Edge: id="e_edge_2", port="key1", target="n4", targetPort="in", label="" -->
    <!-- Edge: id="e_edge_3", port="key2", target="n5", targetPort="in", label="" -->
    <!-- Edge: id="e_edge_4", port="key3", target="n6", targetPort="in", label="" -->
    <!-- Edge: id="e_edge_5", port="key1", target="n7", targetPort="in", label="" -->
    <!-- Edge: id="e_edge_6", port="key1", target="n8", targetPort="in", label="" -->
    <!-- Edge: id="e_edge_7", port="key1", target="n9", targetPort="in", label="" -->
    <!-- Edge: id="e_edge_8", port="key1", target="n10", targetPort="in", label="" -->
    <!-- Edge: id="e_edge_9", port="key1", target="n11", targetPort="in", label="" -->
    <!-- Edge: id="e_edge_10", port="key0", target="n12", targetPort="in", label="" -->
    <!-- Edge: id="e_edge_22", port="timeout", target="n13", targetPort="in", label="" -->
    <menu>
      <prompt>Press 1 for Reservations, Press 2 for Front Desk, Press 3...</prompt>
      <choice dtmf="1" next="#n4">Key 1</choice>
      <choice dtmf="2" next="#n5">Key 2</choice>
      <choice dtmf="3" next="#n6">Key 3</choice>
      <choice dtmf="0" next="#n12">Key 0</choice>
      <choice dtmf="4" next="#n13"/>
    </menu>
  </form>
  <!-- Check Hours Reservations (n4) -->
  <form id="n4" type="condition" title="Check Hours Reservations" subtitle="Branch on expression">
    <!-- Edge: id="e_edge_14", port="true", target="n13", targetPort="in", label="" -->
    <block>
      <if cond="true">
        <goto next="#n13"/>
      </if>
    </block>
  </form>
  <!-- Check Hours Front Desk (n5) -->
  <form id="n5" type="condition" title="Check Hours Front Desk" subtitle="Branch on expression">
    <!-- Edge: id="e_edge_15", port="true", target="n13", targetPort="in", label="" -->
    <block>
      <if cond="true">
        <goto next="#n13"/>
      </if>
    </block>
  </form>
  <!-- Check Hours Room Service (n6) -->
  <form id="n6" type="condition" title="Check Hours Room Service" subtitle="Branch on expression">
    <!-- Edge: id="e_edge_16", port="true", target="n13", targetPort="in", label="" -->
    <block>
      <if cond="true">
        <goto next="#n13"/>
      </if>
    </block>
  </form>
  <!-- Check Hours Concierge (n7) -->
  <form id="n7" type="condition" title="Check Hours Concierge" subtitle="Branch on expression">
    <!-- Edge: id="e_edge_17", port="true", target="n13", targetPort="in", label="" -->
    <block>
      <if cond="true">
        <goto next="#n13"/>
      </if>
    </block>
  </form>
  <!-- Check Hours Maintenance (n8) -->
  <form id="n8" type="condition" title="Check Hours Maintenance" subtitle="Branch on expression">
    <!-- Edge: id="e_edge_18", port="true", target="n13", targetPort="in", label="" -->
    <block>
      <if cond="true">
        <goto next="#n13"/>
      </if>
    </block>
  </form>
  <!-- Check Hours Billing (n9) -->
  <form id="n9" type="condition" title="Check Hours Billing" subtitle="Branch on expression">
    <!-- Edge: id="e_edge_19", port="true", target="n13", targetPort="in", label="" -->
    <block>
      <if cond="true">
        <goto next="#n13"/>
      </if>
    </block>
  </form>
  <!-- Check Hours Guest Services (n10) -->
  <form id="n10" type="condition" title="Check Hours Guest Services" subtitle="Branch on expression">
    <!-- Edge: id="e_edge_20", port="true", target="n13", targetPort="in", label="" -->
    <block>
      <if cond="true">
        <goto next="#n13"/>
      </if>
    </block>
  </form>
  <!-- Check Hours Information (n11) -->
  <form id="n11" type="condition" title="Check Hours Information" subtitle="Branch on expression">
    <!-- Edge: id="e_edge_21", port="true", target="n13", targetPort="in", label="" -->
    <block>
      <if cond="true">
        <goto next="#n13"/>
      </if>
    </block>
  </form>
  <!-- Agent Transfer (n12) -->
  <form id="n12" type="transfer" title="Agent Transfer" subtitle="Connecting you to a hotel agent.">
    <!-- Edge: id="e_edge_23", port="fail", target="n13", targetPort="in", label="" -->
    <transfer name="n12_result" dest="TRANSFER_TARGET_PLACEHOLDER">
      <prompt>Connecting you to a hotel agent.</prompt>
    </transfer>
    <filled>
      <if cond="n12_result != 'near_end_disconnect'">
        <goto next="#n13"/>
      </if>
    </filled>
  </form>
  <!-- End Call (n13) -->
  <form id="n13" type="end" title="End Call" subtitle="Hang up">
    <block>
      <prompt>Hang up</prompt>
      <disconnect/>
    </block>
  </form>
</vxml>