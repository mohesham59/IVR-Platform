<?xml version="1.0" encoding="UTF-8"?>
<vxml version="2.1" xmlns="http://www.w3.org/2001/vxml">

  <!-- E2E form-only test: no <menu>, so the renderer drives the first form.
       Covers prompt, assign, var, if/then/else and goto in a <block>. -->

  <form id="start">
    <block>
      <prompt>Form only test.</prompt>
      <assign name="api_secret" expr="'s3cr3t'"/>
      <var name="status" expr="'active'"/>
      <if cond="'${status}' == 'active'">
        <then><prompt>Status is active.</prompt></then>
        <else><prompt>Status is inactive.</prompt></else>
      </if>
      <goto next="#end_form"/>
    </block>
  </form>

  <form id="end_form">
    <block>
      <prompt>End of form test.</prompt>
    </block>
  </form>

</vxml>
