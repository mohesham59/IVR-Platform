<?xml version="1.0" encoding="UTF-8"?>
<vxml version="2.1" xmlns="http://www.w3.org/2001/vxml">

  <!-- Entry Point: Language Selection -->
  <menu id="lang_selection" dtmf="true">
    <prompt>
      <audio xml:lang="en">Welcome to the Arabic testing flow. For English, press 1.</audio>
      <audio xml:lang="ar">مَرْحَبًا بِكُمْ فِي نِظَامِ الِاخْتِبَارِ. لِلْعَرَبِيَّةِ اضْغَطْ رَقَمَ اِثْنَيْنِ</audio>
    </prompt>
    <choice dtmf="1" next="#set_english"/>
    <choice dtmf="2" next="#set_arabic"/>
  </menu>

  <!-- Language Assignment blocks -->
  <form id="set_english">
    <block>
      <assign name="language" expr="'en'"/>
      <goto next="#main_menu_en"/>
    </block>
  </form>

  <form id="set_arabic">
    <block>
      <assign name="language" expr="'ar'"/>
      <goto next="#main_menu_ar"/>
    </block>
  </form>


  <!-- ==================== ARABIC FLOW ==================== -->
  
  <menu id="main_menu_ar" dtmf="true">
    <prompt xml:lang="ar">
      أَهْلًا بِكَ فِي الْقَائِمَةِ الرَّئِيسِيَّةِ. 
      لِاخْتِبَارِ الْمُحَادَثَةِ مَعَ الذَّكَاءِ الِاصْطِنَاعِيِّ، اضْغَطْ 1. 
      لِاخْتِبَارِ تَسْجِيلِ الصَّوْتِ، اضْغَطْ 2.
      لِلْخُرُوجِ اضْغَطْ 3.
    </prompt>
    <choice dtmf="1" next="#ai_test_ar"/>
    <choice dtmf="2" next="#record_test_ar"/>
    <choice dtmf="3" next="#end_call_ar"/>
  </menu>

  <!-- 1. AI Conversational Test (Arabic) -->
  <form id="ai_test_ar">
    <ai role="You are a helpful assistant." options="Talk to support, Finish testing">
      <prompt xml:lang="ar">
        مَرْحَبًا، أَنَا الْمُسَاعِدُ الذَّكِيُّ. كَيْفَ يُمْكِنُنِي مُسَاعَدَتُكَ الْيَوْمَ؟ تَحَدَّثْ بَعْدَ الصَّافِرَةِ.
      </prompt>
    </ai>
  </form>

  <!-- 2. Standard Record / STT Test (Arabic) -->
  <form id="record_test_ar">
    <record name="user_audio" beep="true" maxtime="10s" finalsilence="2000ms">
      <prompt xml:lang="ar">
        يُرْجَى تَرْكُ رِسَالَةٍ قَصِيرَةٍ بَعْدَ الصَّافِرَةِ لِاخْتِبَارِ التَّعَرُّفِ عَلَى الْكَلَامِ.
      </prompt>
    </record>
    <block>
      <prompt xml:lang="ar">شُكْرًا لَكَ، لَقَدْ تَمَّ تَسْجِيلُ رِسَالَتِكَ بِنَجَاحٍ.</prompt>
      <goto next="#end_call_ar"/>
    </block>
  </form>

  <form id="end_call_ar">
    <block>
      <prompt xml:lang="ar">شُكْرًا لِاسْتِخْدَامِكَ النِّظَامَ. مَعَ السَّلَامَةِ.</prompt>
      <disconnect/>
    </block>
  </form>


  <!-- ==================== ENGLISH FLOW ==================== -->
  
  <menu id="main_menu_en" dtmf="true">
    <prompt xml:lang="en">
      Welcome to the main menu. 
      To test the AI conversation, press 1. 
      To test voice recording, press 2.
      To exit, press 3.
    </prompt>
    <choice dtmf="1" next="#ai_test_en"/>
    <choice dtmf="2" next="#record_test_en"/>
    <choice dtmf="3" next="#end_call_en"/>
  </menu>

  <!-- 1. AI Conversational Test (English) -->
  <form id="ai_test_en">
    <ai role="You are a helpful assistant." options="Talk to support, Finish testing">
      <prompt xml:lang="en">
        Hello, I am the AI assistant. How can I help you today? Please speak after the beep.
      </prompt>
    </ai>
  </form>

  <!-- 2. Standard Record / STT Test (English) -->
  <form id="record_test_en">
    <record name="user_audio" beep="true" maxtime="10s" finalsilence="2000ms">
      <prompt xml:lang="en">
        Please leave a short message after the beep to test speech recognition.
      </prompt>
    </record>
    <block>
      <prompt xml:lang="en">Thank you, your message has been successfully recorded.</prompt>
      <goto next="#end_call_en"/>
    </block>
  </form>

  <form id="end_call_en">
    <block>
      <prompt xml:lang="en">Thank you for using our system. Goodbye.</prompt>
      <disconnect/>
    </block>
  </form>

</vxml>
