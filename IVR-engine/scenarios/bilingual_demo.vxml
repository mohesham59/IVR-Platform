<?xml version="1.0" encoding="UTF-8"?>
<vxml version="2.1" xmlns="http://www.w3.org/2001/vxml">

  <!-- ========================================================================
       bilingual_demo.vxml

       A bilingual (Arabic/English) IVR scenario that exercises every feature
       the FastAGI renderer supports:

       [menu] + [choice]          bilingual DTMF main menu
       [prompt xml:lang=ar|en]    per-prompt TTS language selection
       [assign] / [var]           session variables
       [if][then][else]           condition evaluation
       [field] + [grammar]        DTMF digit collection, '#' terminates
       [api]                      external HTTP(S) GET + jsonPath + saveResultAs
       [record]                   voice message recording
       [transfer]                 dial a target with [filled]/[catch]
       [ai]                       record -> ASR -> LLM -> jump to a dialog
       [audio]                    custom audio file with TTS fallback
       [goto]                     jump to another dialog
       [disconnect]               hang up
       ${var} substitution        variables interpolated into prompts

       Test guide: see BILINGUAL_DEMO.md (repo root).
       ======================================================================== -->

  <!-- The renderer renders the FIRST [menu] and ignores leading [form] welcome
       blocks, so the bilingual greeting lives inside the menu prompts. -->
  <menu id="main_menu" dtmf="true">
    <prompt xml:lang="ar">
      مرحباً بك في خدمة الرد الآلي التجريبية. اضغط 1 للحجز، 2 لرصيد الحساب،
      3 لاختبار واجهة برمجية خارجية، 4 لتسجيل رسالة صوتية، 5 للمساعد الذكي،
      6 للتحويل إلى موظف، 7 لاختبار الصوت المخصص، أو 0 للإنهاء.
    </prompt>
    <prompt xml:lang="en">
      Welcome to the integrated IVR demo. Press 1 for booking, 2 for account balance,
      3 for an external API test, 4 to record a voice message, 5 for the AI assistant,
      6 to transfer to an agent, 7 to test custom audio, or 0 to exit.
    </prompt>
    <choice dtmf="1" next="#book"/>
    <choice dtmf="2" next="#account"/>
    <choice dtmf="3" next="#api_test"/>
    <choice dtmf="4" next="#record_msg"/>
    <choice dtmf="5" next="#assist"/>
    <choice dtmf="6" next="#transfer"/>
    <choice dtmf="7" next="#audio_test"/>
    <choice dtmf="0" next="#end"/>
  </menu>

  <!-- ====================================================================
       Option 1: [field] + [grammar] DTMF input collection.
       Field prompts are DTMF-aware; '#' finishes the digit sequence.
       ==================================================================== -->
  <form id="book">
    <block>
      <prompt xml:lang="en">Booking. Press 1 for action movies or 2 for comedy.</prompt>
      <prompt xml:lang="ar">الحجز. اضغط 1 لأفلام الأكشن أو 2 للكوميديا.</prompt>
    </block>
    <field name="movie_selection" type="digits">
      <prompt xml:lang="en">Press 1 or 2, then press the hash key.</prompt>
      <prompt xml:lang="ar">اضغط 1 أو 2 ثم اضغط علامة الشباك.</prompt>
      <grammar>1 2</grammar>
    </field>
    <filled>
      <prompt xml:lang="en">You selected option ${movie_selection}. Booking confirmed. Goodbye.</prompt>
      <prompt xml:lang="ar">اخترت الخيار ${movie_selection}. تم تأكيد الحجز. مع السلامة.</prompt>
    </filled>
  </form>

  <!-- ====================================================================
       Option 2: [assign]/[var], session language switching,
       [if]/[then]/[else], and ${var} substitution.
       ==================================================================== -->
  <form id="account">
    <block>
      <assign name="balance" expr="'50'"/>
      <var name="status" expr="'active'"/>

      <!-- Switch the session language to Arabic: subsequent prompts without
           xml:lang are synthesized in Arabic, and [ai] ASR uses ar-EG. -->
      <assign name="language" expr="'ar'"/>
      <prompt>تغيير اللغة إلى العربية. رصيدك الحالي هو ${balance} جنيه.</prompt>

      <if cond="'${balance}' >= '100'">
        <then>
          <prompt xml:lang="ar">رصيدك مرتفع.</prompt>
          <prompt xml:lang="en">Your balance is high.</prompt>
        </then>
        <else>
          <prompt xml:lang="ar">رصيدك منخفض.</prompt>
          <prompt xml:lang="en">Your balance is low.</prompt>
        </else>
      </if>

      <if cond="${status} == 'active'">
        <then><prompt>الحساب نشط.</prompt></then>
        <else><prompt>الحساب غير نشط.</prompt></else>
      </if>

      <!-- Switch back to English. -->
      <assign name="language" expr="'en'"/>
      <prompt>Switching back to English. The account demo is complete.</prompt>
    </block>
  </form>

  <!-- ====================================================================
       Option 3: [api] external HTTP(S) GET.
       url         : http/https endpoint (other schemes are blocked)
       var         : optional; appends ?var=<session var> to the URL
       jsonPath    : optional; extracts a top-level JSON field
       saveResultAs: stores the result in a session variable
       Result is spoken back via ${weather_timezone} substitution.
       ==================================================================== -->
  <form id="api_test">
    <block>
      <prompt xml:lang="en">Testing an external weather API. Please wait.</prompt>
      <prompt xml:lang="ar">اختبار واجهة برمجية للطقس. أرجو الانتظار.</prompt>
      <api url="https://api.open-meteo.com/v1/forecast?latitude=52.52&amp;longitude=13.41&amp;current_weather=true&amp;timezone=auto"
           saveResultAs="weather_timezone"
           jsonPath="timezone"/>
      <prompt xml:lang="en">The weather service reports the timezone: ${weather_timezone}.</prompt>
      <prompt xml:lang="ar">خدمة الطقس تخبرنا بأن المنطقة الزمنية هي: ${weather_timezone}.</prompt>
    </block>
  </form>

  <!-- ====================================================================
       Option 4: [record] voice message recording (beep, '#' to finish).
       ==================================================================== -->
  <form id="record_msg">
    <block>
      <prompt xml:lang="en">Please record your message after the beep.</prompt>
      <prompt xml:lang="ar">يرجى تسجيل رسالتك بعد التنبيه.</prompt>
      <record name="voice_msg" maxtime="10s" beep="true" dtmfterm="true"/>
      <prompt xml:lang="en">Your message was recorded at ${voice_msg}.</prompt>
      <prompt xml:lang="ar">تم تسجيل رسالتك بنجاح.</prompt>
    </block>
  </form>

  <!-- ====================================================================
       Option 5: [ai] speech assistant.
       Records speech -> Google ASR (language from session 'language') ->
       Ollama decision ({"status":"FINAL","action":"<id>"}) -> jump.
       ==================================================================== -->
  <form id="assist">
    <block>
      <ai role="You are a bilingual IVR voice assistant."
          options="balance:balance_info; hours:hours_info; operator:operator_info">
        <prompt xml:lang="en">Say balance, business hours, or operator.</prompt>
        <prompt xml:lang="ar">قل: الرصيد، أو ساعات العمل، أو موظف.</prompt>
      </ai>
    </block>
  </form>

  <form id="balance_info">
    <block>
      <prompt xml:lang="en">Your current balance is five thousand pounds.</prompt>
      <prompt xml:lang="ar">رصيدك الحالي هو خمسة آلاف جنيه.</prompt>
    </block>
  </form>

  <form id="hours_info">
    <block>
      <prompt xml:lang="en">We are open every day from nine in the morning until five in the afternoon.</prompt>
      <prompt xml:lang="ar">نعمل يومياً من التاسعة صباحاً حتى الخامسة مساءً.</prompt>
    </block>
  </form>

  <form id="operator_info">
    <block>
      <prompt xml:lang="en">Transferring you to the operator.</prompt>
      <prompt xml:lang="ar">جاري تحويلك إلى الموظف.</prompt>
    </block>
  </form>

  <!-- ====================================================================
       Option 6: [transfer] to an extension with [filled]/[catch].
       ==================================================================== -->
  <form id="transfer">
    <block>
      <prompt xml:lang="en">Transferring you to an agent.</prompt>
      <prompt xml:lang="ar">جاري تحويلك إلى موظف.</prompt>
      <transfer dest="6001">
        <filled>
          <prompt xml:lang="en">The agent has answered.</prompt>
          <prompt xml:lang="ar">الموظف متصل الآن.</prompt>
        </filled>
        <catch>
          <prompt xml:lang="en">The agent is unavailable. Goodbye.</prompt>
          <prompt xml:lang="ar">الموظف غير متوفر حالياً. مع السلامة.</prompt>
        </catch>
      </transfer>
    </block>
  </form>

  <!-- ====================================================================
       Option 7: [audio] custom audio file.
       Files resolve from /var/lib/asterisk/sounds/ivr-custom/.
       Since the file does not exist here, the inner text is used as TTS
       fallback (per xml:lang of the [audio] element).
       ==================================================================== -->
  <form id="audio_test">
    <block>
      <prompt>
        <audio xml:lang="en" src="welcome_custom.wav">
          The custom audio file was not found, so this fallback text is being read instead.
        </audio>
        <audio xml:lang="ar" src="welcome_custom_ar.wav">
          لم يتم العثور على الملف الصوتي المخصص، لذلك يتم قراءة هذا النص البديل.
        </audio>
      </prompt>
    </block>
  </form>

  <!-- ====================================================================
       Option 0: [disconnect] hang up.
       ==================================================================== -->
  <form id="end">
    <block>
      <prompt xml:lang="en">Thank you for calling. Goodbye.</prompt>
      <prompt xml:lang="ar">شكراً لاتصالك. مع السلامة.</prompt>
      <disconnect/>
    </block>
  </form>

</vxml>
