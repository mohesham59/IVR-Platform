<?xml version="1.0" encoding="UTF-8"?>
<vxml version="2.1" xmlns="http://www.w3.org/2001/vxml">
  <meta name="flow-name" content="Frontend Flow"/>
  <!-- Start (n1) -->
  <form id="n1">
    <block>
      <prompt bargein="false">Entry Point</prompt>
      <goto next="#n2"/>
    </block>
  </form>
  <!-- Lang select (n2) -->
  <menu id="n2">
      <prompt bargein="true" xml:lang="en">
        For English press 1, for Arabic press 2.
      </prompt>
      <prompt bargein="true" xml:lang="ar">
        للتحدث بالإنجليزية اضغط 1، للتحدث بالعربية اضغط 2.
      </prompt>
      <choice dtmf="1" next="#n15"/>
      <choice dtmf="2" next="#n4"/>
      <noinput>
        <prompt xml:lang="en">We did not receive any input. Please try again.</prompt>
        <prompt xml:lang="ar">لم نتلق أي إدخال. يرجى المحاولة مرة أخرى.</prompt>
        <reprompt/>
      </noinput>
      <nomatch>
        <prompt xml:lang="en">Invalid option. Please try again.</prompt>
        <prompt xml:lang="ar">خيار غير صالح. يرجى المحاولة مرة أخرى.</prompt>
        <reprompt/>
      </nomatch>
  </menu>
  <!-- Lang en (n3) -->
  <form id="n3">
    <block>
      <assign name="language" expr="'en'"/>
      <goto next="#n5"/>
    </block>
  </form>
  <!-- Lang ar (n4) -->
  <form id="n4">
    <block>
      <assign name="language" expr="'ar'"/>
      <goto next="#n5"/>
    </block>
  </form>
  <!-- Account (n5) -->
  <form id="n5">
    <field name="n5" type="digits">
      <prompt bargein="true" xml:lang="en">
        Please enter your 10‑digit account number followed by pound.
      </prompt>
      <prompt bargein="true" xml:lang="ar">
        أدخل رقم حسابك المكون من 10 أرقام مع زر الحرف pound.
      </prompt>
      <filled>
        <goto next="#n6"/>
      </filled>
      <noinput>
        <prompt xml:lang="en">We did not receive any input. Please try again.</prompt>
        <prompt xml:lang="ar">لم نتلق أي إدخال. يرجى المحاولة مرة أخرى.</prompt>
        <reprompt/>
      </noinput>
      <nomatch>
        <prompt xml:lang="en">Invalid option. Please try again.</prompt>
        <prompt xml:lang="ar">خيار غير صالح. يرجى المحاولة مرة أخرى.</prompt>
        <reprompt/>
      </nomatch>
    </field>
  </form>
  <!-- Pin (n6) -->
  <form id="n6">
    <field name="n6" type="digits">
      <prompt bargein="true" xml:lang="en">
        Enter your 4‑digit PIN followed by pound.
      </prompt>
      <prompt bargein="true" xml:lang="ar">
        أدخل رقم التعريف الشخصي المكون من 4 أرقام مع زر الحرف pound.
      </prompt>
      <filled>
        <goto next="#n7"/>
      </filled>
      <noinput>
        <prompt xml:lang="en">We did not receive any input. Please try again.</prompt>
        <prompt xml:lang="ar">لم نتلق أي إدخال. يرجى المحاولة مرة أخرى.</prompt>
        <reprompt/>
      </noinput>
      <nomatch>
        <prompt xml:lang="en">Invalid option. Please try again.</prompt>
        <prompt xml:lang="ar">خيار غير صالح. يرجى المحاولة مرة أخرى.</prompt>
        <reprompt/>
      </nomatch>
    </field>
  </form>
  <!-- Main menu (n7) -->
  <menu id="n7">
      <prompt bargein="true" xml:lang="en">
        Press 1 for Balance Inquiry, 2 for Card Services, 3 for Loan Status, 4 for Live Agent, 5 for Fraud Hotline, 0 to End Call.
      </prompt>
      <prompt bargein="true" xml:lang="ar">
        اضغط 1 للاستعلام عن الرصيد، 2 لخدمات البطاقة، 3 لحالة القرض، 4 للوكيل المباشر، 5 للخط الساخن للاحتيال، 0 لإنهاء المكالمة.
      </prompt>
      <choice dtmf="1" next="#n15"/>
      <choice dtmf="2" next="#n9"/>
      <choice dtmf="3" next="#n13"/>
      <choice dtmf="4" next="#n15"/>
      <choice dtmf="5" next="#n14"/>
      <choice dtmf="0" next="#n16"/>
      <noinput>
        <prompt xml:lang="en">We did not receive any input. Please try again.</prompt>
        <prompt xml:lang="ar">لم نتلق أي إدخال. يرجى المحاولة مرة أخرى.</prompt>
        <reprompt/>
      </noinput>
      <nomatch>
        <prompt xml:lang="en">Invalid option. Please try again.</prompt>
        <prompt xml:lang="ar">خيار غير صالح. يرجى المحاولة مرة أخرى.</prompt>
        <reprompt/>
      </nomatch>
  </menu>
  <!-- Balance inquiry (n8) -->
  <form id="n8">
    <block>
      <prompt bargein="false" xml:lang="en">
        Your account ending with 1234 has a balance of $1,234.56.
      </prompt>
      <prompt bargein="false" xml:lang="ar">
        حسابك ينتهي برقم 1234، والرصيد 1,234.56 دولار.
      </prompt>
      <goto next="#n7"/>
    </block>
  </form>
  <!-- Card services (n9) -->
  <menu id="n9">
      <prompt bargein="true" xml:lang="en">
        Press 1 to Activate Card, 2 to Report Lost Card, 3 to View Card Limits, 0 to Return to Main Menu.
      </prompt>
      <prompt bargein="true" xml:lang="ar">
        اضغط 1 لتفعيل البطاقة، 2 للإبلاغ عن بطاقة مفقودة، 3 لعرض حدود البطاقة، 0 للعودة إلى القائمة الرئيسية.
      </prompt>
      <choice dtmf="1" next="#n15"/>
      <choice dtmf="2" next="#n11"/>
      <choice dtmf="3" next="#n12"/>
      <choice dtmf="0" next="#n7"/>
      <noinput>
        <prompt xml:lang="en">We did not receive any input. Please try again.</prompt>
        <prompt xml:lang="ar">لم نتلق أي إدخال. يرجى المحاولة مرة أخرى.</prompt>
        <reprompt/>
      </noinput>
      <nomatch>
        <prompt xml:lang="en">Invalid option. Please try again.</prompt>
        <prompt xml:lang="ar">خيار غير صالح. يرجى المحاولة مرة أخرى.</prompt>
        <reprompt/>
      </nomatch>
  </menu>
  <!-- Card activation (n10) -->
  <form id="n10">
    <block>
      <prompt bargein="false" xml:lang="en">
        Your card has been activated.
      </prompt>
      <prompt bargein="false" xml:lang="ar">
        تم تفعيل بطاقتك.
      </prompt>
      <goto next="#n7"/>
    </block>
  </form>
  <!-- Lost card (n11) -->
  <form id="n11">
    <block>
      <prompt bargein="false" xml:lang="en">
        Your lost card has been reported.
      </prompt>
      <prompt bargein="false" xml:lang="ar">
        تمت الإبلاغ عن بطاقتك المفقودة.
      </prompt>
      <goto next="#n7"/>
    </block>
  </form>
  <!-- Card limits (n12) -->
  <form id="n12">
    <block>
      <prompt bargein="false" xml:lang="en">
        Your card limit is $5,000.
      </prompt>
      <prompt bargein="false" xml:lang="ar">
        حد بطاقةك هو 5,000 دولار.
      </prompt>
      <goto next="#n7"/>
    </block>
  </form>
  <!-- Loan status (n13) -->
  <form id="n13">
    <block>
      <prompt bargein="false" xml:lang="en">
        Your loan is current with a balance of $10,000.
      </prompt>
      <prompt bargein="false" xml:lang="ar">
        قرضك الحالي مع رصيد 10,000 دولار.
      </prompt>
      <goto next="#n7"/>
    </block>
  </form>
  <!-- Fraud hotline (n14) -->
  <form id="n14">
    <block>
      <prompt bargein="false" xml:lang="en">
        Connecting you to the fraud hotline.
      </prompt>
      <prompt bargein="false" xml:lang="ar">
        جاري تحويلك إلى الخط الساخن للاحتيال.
      </prompt>
      <transfer dest="Transfer the call to an agent or number"/>
    </block>
  </form>
  <!-- Live agent (n15) -->
  <form id="n15">
    <block>
      <prompt bargein="false" xml:lang="en">
        Connecting you to a live agent.
      </prompt>
      <prompt bargein="false" xml:lang="ar">
        جاري تحويلك إلى وكيل مباشر.
      </prompt>
      <transfer dest="Transfer the call to an agent or number"/>
    </block>
  </form>
  <!-- End Call (n16) -->
  <form id="n16">
    <block>
      <prompt bargein="false" xml:lang="en">
        Thank you for calling XYZ Bank. Have a safe day.
      </prompt>
      <prompt bargein="false" xml:lang="ar">
        شكرًا لاتصالك بـ XYZ Bank. أتمنى لك يومًا آمنًا.
      </prompt>
      <disconnect/>
    </block>
  </form>
</vxml>