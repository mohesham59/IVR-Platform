<?xml version="1.0" encoding="UTF-8"?>
<vxml version="2.1" xmlns="http://www.w3.org/2001/vxml">
  <!-- Flow Name: Frontend Flow -->
  <!-- Start (n1) -->
  <form id="n1" type="start" title="Start" subtitle="Welcome to XYZ Bank. For your security, please enter your...">
    <!-- Edge: id="e_edge_1", port="out", target="n2", targetPort="in", label="" -->
      <prompt>Welcome to XYZ Bank. For your security, please enter your...</prompt>
      <goto next="#n2"/>
  </form>
  <!-- Account Number Auth (n2) -->
  <form id="n2" type="input" title="Account Number Auth" subtitle="Collect digit input">
    <!-- Edge: id="e_edge_2", port="success", target="n11", targetPort="in", label="" -->
    <!-- Edge: id="e_edge_3", port="success", target="n3", targetPort="in", label="" -->
    <!-- Edge: id="e_n2_n12_1786033999506", port="timeout", target="n12", targetPort="in", label="" -->
    <field name="n2">
      <prompt>Collect digit input</prompt>
      <grammar mode="dtmf" version="1.0">
        <rule id="digits"><one-of>
          <item>0</item>
          <item>1</item>
          <item>2</item>
          <item>3</item>
          <item>4</item>
          <item>5</item>
          <item>6</item>
          <item>7</item>
          <item>8</item>
          <item>9</item>
        </one-of></rule>
      </grammar>
      <filled>
        <goto next="#n11"/>
      </filled>
      <noinput>
        <goto next="#n12"/>
      </noinput>
    </field>
  </form>
  <!-- PIN Authentication (n3) -->
  <form id="n3" type="input" title="PIN Authentication" subtitle="Collect digit input">
    <!-- Edge: id="e_edge_4", port="success", target="n11", targetPort="in", label="" -->
    <!-- Edge: id="e_edge_5", port="success", target="n4", targetPort="in", label="" -->
    <!-- Edge: id="e_n3_n12_1786034020954", port="timeout", target="n12", targetPort="in", label="" -->
    <field name="n3">
      <prompt>Collect digit input</prompt>
      <grammar mode="dtmf" version="1.0">
        <rule id="digits"><one-of>
          <item>0</item>
          <item>1</item>
          <item>2</item>
          <item>3</item>
          <item>4</item>
          <item>5</item>
          <item>6</item>
          <item>7</item>
          <item>8</item>
          <item>9</item>
        </one-of></rule>
      </grammar>
      <filled>
        <goto next="#n11"/>
      </filled>
      <noinput>
        <goto next="#n12"/>
      </noinput>
    </field>
  </form>
  <!-- Main Navigation Menu (n4) -->
  <form id="n4" type="menu" title="Main Navigation Menu" subtitle="Please select an option: Press 1 for Balance, Press 2 for...">
    <!-- Edge: id="e_edge_6", port="key1", target="n5", targetPort="in", label="" -->
    <!-- Edge: id="e_edge_7", port="key2", target="n7", targetPort="in", label="" -->
    <!-- Edge: id="e_edge_8", port="key3", target="n8", targetPort="in", label="" -->
    <!-- Edge: id="e_edge_9", port="key1", target="n9", targetPort="in", label="" -->
    <!-- Edge: id="e_edge_10", port="key0", target="n12", targetPort="in", label="" -->
    <!-- Edge: id="e_edge_12", port="key1", target="n10", targetPort="in", label="" -->
    <!-- Edge: id="e_edge_13", port="timeout", target="n12", targetPort="in", label="" -->
    <menu>
      <prompt>Please select an option: Press 1 for Balance, Press 2 for...</prompt>
      <choice dtmf="1" next="#n5">Key 1</choice>
      <choice dtmf="2" next="#n7">Key 2</choice>
      <choice dtmf="3" next="#n8">Key 3</choice>
      <choice dtmf="0" next="#n12">Key 0</choice>
      <choice dtmf="4" next="#n12"/>
    </menu>
  </form>
  <!-- Balance Last4 (n5) -->
  <form id="n5" type="input" title="Balance Last4" subtitle="Collect digit input">
    <!-- Edge: id="e_edge_11", port="success", target="n6", targetPort="in", label="" -->
    <field name="n5">
      <prompt>Collect digit input</prompt>
      <grammar mode="dtmf" version="1.0">
        <rule id="digits"><one-of>
          <item>0</item>
          <item>1</item>
          <item>2</item>
          <item>3</item>
          <item>4</item>
          <item>5</item>
          <item>6</item>
          <item>7</item>
          <item>8</item>
          <item>9</item>
        </one-of></rule>
      </grammar>
      <filled>
        <goto next="#n6"/>
      </filled>
    </field>
  </form>
  <!-- Transfer Balance (n6) -->
  <form id="n6" type="transfer" title="Transfer Balance" subtitle="Transferring you to balance inquiry.">
    <!-- Edge: id="e_edge_14", port="fail", target="n12", targetPort="in", label="" -->
    <transfer name="n6_result" dest="TRANSFER_TARGET_PLACEHOLDER">
      <prompt>Transferring you to balance inquiry.</prompt>
    </transfer>
    <filled>
      <if cond="n6_result != 'near_end_disconnect'">
        <goto next="#n12"/>
      </if>
    </filled>
  </form>
  <!-- Transfer Card Services (n7) -->
  <form id="n7" type="transfer" title="Transfer Card Services" subtitle="Transferring you to card services.">
    <!-- Edge: id="e_edge_15", port="fail", target="n12", targetPort="in", label="" -->
    <transfer name="n7_result" dest="TRANSFER_TARGET_PLACEHOLDER">
      <prompt>Transferring you to card services.</prompt>
    </transfer>
    <filled>
      <if cond="n7_result != 'near_end_disconnect'">
        <goto next="#n12"/>
      </if>
    </filled>
  </form>
  <!-- Transfer Loan Status (n8) -->
  <form id="n8" type="transfer" title="Transfer Loan Status" subtitle="Transferring you to loan status.">
    <!-- Edge: id="e_edge_16", port="fail", target="n12", targetPort="in", label="" -->
    <transfer name="n8_result" dest="TRANSFER_TARGET_PLACEHOLDER">
      <prompt>Transferring you to loan status.</prompt>
    </transfer>
    <filled>
      <if cond="n8_result != 'near_end_disconnect'">
        <goto next="#n12"/>
      </if>
    </filled>
  </form>
  <!-- Transfer Agent (n9) -->
  <form id="n9" type="transfer" title="Transfer Agent" subtitle="Transferring you to a live agent.">
    <!-- Edge: id="e_edge_17", port="fail", target="n12", targetPort="in", label="" -->
    <transfer name="n9_result" dest="TRANSFER_TARGET_PLACEHOLDER">
      <prompt>Transferring you to a live agent.</prompt>
    </transfer>
    <filled>
      <if cond="n9_result != 'near_end_disconnect'">
        <goto next="#n12"/>
      </if>
    </filled>
  </form>
  <!-- Transfer Fraud Hotline (n10) -->
  <form id="n10" type="transfer" title="Transfer Fraud Hotline" subtitle="Transferring you to the fraud hotline.">
    <!-- Edge: id="e_edge_18", port="fail", target="n12", targetPort="in", label="" -->
    <transfer name="n10_result" dest="TRANSFER_TARGET_PLACEHOLDER">
      <prompt>Transferring you to the fraud hotline.</prompt>
    </transfer>
    <filled>
      <if cond="n10_result != 'near_end_disconnect'">
        <goto next="#n12"/>
      </if>
    </filled>
  </form>
  <!-- Error Transfer to Agent (n11) -->
  <form id="n11" type="transfer" title="Error Transfer to Agent" subtitle="Too many failed attempts. Transferring you to a live agent.">
    <!-- Edge: id="e_edge_19", port="fail", target="n12", targetPort="in", label="" -->
    <transfer name="n11_result" dest="TRANSFER_TARGET_PLACEHOLDER">
      <prompt>Too many failed attempts. Transferring you to a live agent.</prompt>
    </transfer>
    <filled>
      <if cond="n11_result != 'near_end_disconnect'">
        <goto next="#n12"/>
      </if>
    </filled>
  </form>
  <!-- End Call (n12) -->
  <form id="n12" type="end" title="End Call" subtitle="Hang up">
    <block>
      <prompt>Hang up</prompt>
      <disconnect/>
    </block>
  </form>
</vxml>