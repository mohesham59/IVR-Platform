<?xml version="1.0" encoding="UTF-8"?>
<!--
  VXML Menu Example with <audio> tag support for custom voice recordings.

  HOW TO USE YOUR OWN VOICE:
  1. Record your audio prompts as WAV files (8kHz, 16-bit, mono recommended)
  2. Place them in: /var/lib/asterisk/sounds/ivr-custom/
  3. Reference them in <audio src="filename.wav"> tags below
  4. The text inside <audio> tags is used as TTS fallback if the file is not found

  EXAMPLE:
    Record "For English press 1" and save as: /var/lib/asterisk/sounds/ivr-custom/lang_menu_en.wav
    Record the Arabic equivalent and save as: /var/lib/asterisk/sounds/ivr-custom/lang_menu_ar.wav
    The engine will automatically play your recordings instead of TTS.
-->
<vxml version="2.1" xmlns="http://www.w3.org/2001/vxml">

  <menu id="lang_menu" dtmf="true">
    <prompt>
      <audio src="lang_menu_en.wav" xml:lang="en">For English press 1,</audio>
      <audio src="lang_menu_ar.wav" xml:lang="ar">لِلْعَرَبِيَّةِ اضْغَطْ رَقَمَ اِثْنَيْنِ</audio>
    </prompt>
    <choice dtmf="1" next="#set_english"/>
    <choice dtmf="2" next="#set_arabic"/>
  </menu>

  <form id="set_english">
    <block>
      <assign name="language" expr="'en'"/>
      <goto next="#main_menu_en"/>
    </block>
  </form>

  <form id="set_arabic">
    <block>
      <assign name="language" expr="'ar'"/>
      <goto next="#main_menu_ar"/>
    </block>
  </form>

  <!-- ==================== ENGLISH FLOW ==================== -->
  <menu id="main_menu_en" dtmf="true">
    <prompt>
      <audio src="main_menu_en.wav" xml:lang="en">Welcome to the main menu. Press 1 for reservations, press 2 for customer support.</audio>
    </prompt>
    <choice dtmf="1" next="#reservations_en"/>
    <choice dtmf="2" next="#support_en"/>
  </menu>

  <form id="reservations_en">
    <block>
      <prompt>
        <audio src="reservations_en.wav" xml:lang="en">You selected reservations. Please hold while we process your request.</audio>
      </prompt>
    </block>
  </form>

  <form id="support_en">
    <block>
      <prompt>
        <audio src="support_en.wav" xml:lang="en">You selected customer support. An agent will be with you shortly.</audio>
      </prompt>
    </block>
  </form>

  <!-- ==================== ARABIC FLOW ==================== -->
  <menu id="main_menu_ar" dtmf="true">
    <prompt>
      <audio src="main_menu_ar.wav" xml:lang="ar">أَهْلًا بِكَ فِي الْقَائِمَةِ الرَّئِيسِيَّةِ. لِلْحُجُوزَاتِ اضْغَطْ 1، لِدَعْمِ الْعُمَلَاءِ اضْغَطْ 2.</audio>
    </prompt>
    <choice dtmf="1" next="#reservations_ar"/>
    <choice dtmf="2" next="#support_ar"/>
  </menu>

  <form id="reservations_ar">
    <block>
      <prompt>
        <audio src="reservations_ar.wav" xml:lang="ar">لَقَدْ اخْتَرْتَ الْحُجُوزَاتِ. يُرْجَى الِانْتِظَارُ بَيْنَمَا نُعَالِجُ طَلَبَكَ.</audio>
      </prompt>
    </block>
  </form>

  <form id="support_ar">
    <block>
      <prompt>
        <audio src="support_ar.wav" xml:lang="ar">لَقَدْ اخْتَرْتَ دَعْمَ الْعُمَلَاءِ. سَيَكُونُ مَعَكَ أَحَدُ الْوُكَلاءِ قَرِيبًا.</audio>
      </prompt>
    </block>
  </form>

</vxml>
