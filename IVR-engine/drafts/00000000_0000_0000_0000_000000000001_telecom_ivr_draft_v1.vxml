<vxml version="2.1"
      xmlns="http://www.w3.org/2001/vxml"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.w3.org/2001/vxml
                          http://www.w3.org/TR/voicexml21/vxml.xsd"
      application="root.vxml">

  <!-- ══════════════════════════ GLOBAL VARIABLES ════════════════════════ -->
  <var name="session_id"   expr="session.sessionid"/>
  <var name="caller_id"    expr="session.telephone.ani"/>
  <var name="called_number" expr="session.telephone.dnis"/>
  <meta name="flowname" content="Frontend Flow"/>

  <!-- ══════════════════════════ START ════════════════════════ -->
  <!-- Start (start) -->
  <form id="start">
    <!-- Type: start -->
    <block>
      <prompt>Welcome to XYZ Telecom Customer Support. Please note that...</prompt>
      <goto next="#main_menu"/>
    </block>
  </form>

  <!-- ══════════════════════════ MAIN MENU ════════════════════════ -->
  <!-- Main menu (main_menu) -->
  <menu id="main_menu" dtmf="true">
    <prompt>Press 1 for Billing, Press 2 for Roaming, Press 3 for SIM...</prompt>
    <choice dtmf="1" next="#billing_menu">Key 1</choice>
    <choice dtmf="2" next="#roaming_menu">Key 2</choice>
    <choice dtmf="3" next="#sim_menu">Key 3</choice>
    <choice dtmf="0" next="#specialist_transfer">Key 0</choice>
    <choice dtmf="4" next="#billing_menu"/>
  </menu>

  <!-- ══════════════════════════ BILLING MENU ════════════════════════ -->
  <!-- Billing menu (billing_menu) -->
  <menu id="billing_menu" dtmf="true">
    <prompt>Press 1 for Plan Changes, Press 2 for Outage Reporting, P...</prompt>
    <choice dtmf="1" next="#plan_changes_transfer">Key 1</choice>
    <choice dtmf="2" next="#outage_reporting_transfer">Key 2</choice>
    <choice dtmf="3" next="#main_menu">Key 3</choice>
    <choice dtmf="0" next="#plan_changes_transfer">Key 0</choice>
    <choice dtmf="4" next="#plan_changes_transfer"/>
  </menu>

  <!-- ══════════════════════════ ROAMING MENU ════════════════════════ -->
  <!-- Roaming menu (roaming_menu) -->
  <menu id="roaming_menu" dtmf="true">
    <prompt>Press 1 for Technical Support Troubleshooting, Press 2 to...</prompt>
    <choice dtmf="1" next="#tech_support_transfer">Key 1</choice>
    <choice dtmf="2" next="#main_menu">Key 2</choice>
    <choice dtmf="3" next="#tech_support_transfer">Key 3</choice>
    <choice dtmf="0" next="#tech_support_transfer">Key 0</choice>
    <choice dtmf="4" next="#tech_support_transfer"/>
  </menu>

  <!-- ══════════════════════════ SIM MENU ════════════════════════ -->
  <!-- Sim menu (sim_menu) -->
  <menu id="sim_menu" dtmf="true">
    <prompt>Press 1 for SIM Activation, Press 2 to return to main menu.</prompt>
    <choice dtmf="1" next="#sim_activation_transfer">Key 1</choice>
    <choice dtmf="2" next="#main_menu">Key 2</choice>
    <choice dtmf="3" next="#sim_activation_transfer">Key 3</choice>
    <choice dtmf="0" next="#sim_activation_transfer">Key 0</choice>
    <choice dtmf="4" next="#sim_activation_transfer"/>
  </menu>

  <!-- ══════════════════════════ BROADBAND MENU ════════════════════════ -->
  <!-- Broadband menu (broadband_menu) -->
  <menu id="broadband_menu" dtmf="true">
    <prompt>Press 1 for Broadband Speed Test, Press 2 to return to ma...</prompt>
    <choice dtmf="1" next="#speed_test_transfer">Key 1</choice>
    <choice dtmf="2" next="#main_menu">Key 2</choice>
    <choice dtmf="3" next="#speed_test_transfer">Key 3</choice>
    <choice dtmf="0" next="#speed_test_transfer">Key 0</choice>
    <choice dtmf="4" next="#speed_test_transfer"/>
  </menu>

  <!-- ══════════════════════════ PLAN CHANGES TRANSFER ════════════════════════ -->
  <!-- Plan changes transfer (plan_changes_transfer) -->
  <form id="plan_changes_transfer">
    <!-- Type: transfer -->
    <block>
      <prompt>Transfer to live agent</prompt>
    </block>
    <transfer dest="TRANSFER_TARGET_PLACEHOLDER">
      <filled>
        <goto next="#end_call"/>
      </filled>
      <catch event="error connection.failed">
        <goto next="#main_menu"/>
      </catch>
    </transfer>
  </form>

  <!-- ══════════════════════════ OUTAGE REPORTING TRANSFER ════════════════════════ -->
  <!-- Outage reporting transfer (outage_reporting_transfer) -->
  <form id="outage_reporting_transfer">
    <!-- Type: transfer -->
    <block>
      <prompt>Transfer to live agent</prompt>
    </block>
    <transfer dest="TRANSFER_TARGET_PLACEHOLDER">
      <filled>
        <goto next="#end_call"/>
      </filled>
      <catch event="error connection.failed">
        <goto next="#main_menu"/>
      </catch>
    </transfer>
  </form>

  <!-- ══════════════════════════ TECH SUPPORT TRANSFER ════════════════════════ -->
  <!-- Tech support transfer (tech_support_transfer) -->
  <form id="tech_support_transfer">
    <!-- Type: transfer -->
    <block>
      <prompt>Transfer to live agent</prompt>
    </block>
    <transfer dest="TRANSFER_TARGET_PLACEHOLDER">
      <filled>
        <goto next="#end_call"/>
      </filled>
      <catch event="error connection.failed">
        <goto next="#main_menu"/>
      </catch>
    </transfer>
  </form>

  <!-- ══════════════════════════ SIM ACTIVATION TRANSFER ════════════════════════ -->
  <!-- Sim activation transfer (sim_activation_transfer) -->
  <form id="sim_activation_transfer">
    <!-- Type: transfer -->
    <block>
      <prompt>Transfer to live agent</prompt>
    </block>
    <transfer dest="TRANSFER_TARGET_PLACEHOLDER">
      <filled>
        <goto next="#end_call"/>
      </filled>
      <catch event="error connection.failed">
        <goto next="#main_menu"/>
      </catch>
    </transfer>
  </form>

  <!-- ══════════════════════════ SPEED TEST TRANSFER ════════════════════════ -->
  <!-- Speed test transfer (speed_test_transfer) -->
  <form id="speed_test_transfer">
    <!-- Type: transfer -->
    <block>
      <prompt>Transfer to live agent</prompt>
    </block>
    <transfer dest="TRANSFER_TARGET_PLACEHOLDER">
      <filled>
        <goto next="#end_call"/>
      </filled>
      <catch event="error connection.failed">
        <goto next="#main_menu"/>
      </catch>
    </transfer>
  </form>

  <!-- ══════════════════════════ SPECIALIST TRANSFER ════════════════════════ -->
  <!-- Specialist transfer (specialist_transfer) -->
  <form id="specialist_transfer">
    <!-- Type: transfer -->
    <block>
      <prompt>Transfer to live agent</prompt>
    </block>
    <transfer dest="TRANSFER_TARGET_PLACEHOLDER">
      <filled>
        <goto next="#end_call"/>
      </filled>
      <catch event="error connection.failed">
        <goto next="#main_menu"/>
      </catch>
    </transfer>
  </form>

  <!-- ══════════════════════════ END CALL ════════════════════════ -->
  <!-- End call (end_call) -->
  <form id="end_call">
    <!-- Type: end -->
    <block>
      <prompt>Hang up</prompt>
      <disconnect/>
    </block>
  </form>
</vxml>